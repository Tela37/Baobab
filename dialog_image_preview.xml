<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#EE000000">

    <!-- Image en arrière-plan (Z-index inférieur) -->
    <ImageView
        android:id="@+id/imgEnlarged"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:adjustViewBounds="true"
        android:contentDescription="Image agrandie"
        android:scaleType="fitCenter" />

    <!-- Bouton Fermer (X) en premier plan (Z-index supérieur) -->
    <ImageButton
        android:id="@+id/ibClosePreview"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_alignParentTop="true"
        android:layout_alignParentEnd="true"
        android:layout_marginTop="20dp"
        android:layout_marginEnd="20dp"
        android:background="@drawable/badge_background"
        android:backgroundTint="#80000000"
        android:contentDescription="Fermer"
        android:elevation="24dp"
        android:padding="12dp"
        android:src="@android:drawable/ic_menu_close_clear_cancel"
        android:translationZ="24dp"
        app:tint="#FFFFFF" />

</RelativeLayout>