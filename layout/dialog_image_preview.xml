<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#EE000000">

    <!-- Image en arrière-plan (Z-index inférieur) -->
    <ImageView
        android:id="@+id/imgEnlarged"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:adjustViewBounds="true"
        android:contentDescription="Image agrandie"
        android:scaleType="fitCenter" />

    <!-- Bouton Télécharger en premier plan -->
    <ImageButton
        android:id="@+id/ibDownloadPreview"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_alignParentTop="true"
        android:layout_toStartOf="@id/ibSharePreview"
        android:layout_marginTop="20dp"
        android:layout_marginEnd="10dp"
        android:background="@drawable/badge_background"
        android:backgroundTint="#80000000"
        android:contentDescription="Télécharger"
        android:elevation="24dp"
        android:padding="12dp"
        android:src="@android:drawable/stat_sys_download"
        android:translationZ="24dp"
        app:tint="#FFFFFF" />

    <!-- Bouton Partager en premier plan -->
    <ImageButton
        android:id="@+id/ibSharePreview"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_alignParentTop="true"
        android:layout_toStartOf="@id/ibClosePreview"
        android:layout_marginTop="20dp"
        android:layout_marginEnd="10dp"
        android:background="@drawable/badge_background"
        android:backgroundTint="#80000000"
        android:contentDescription="Partager"
        android:elevation="24dp"
        android:padding="12dp"
        android:src="@android:drawable/ic_menu_share"
        android:translationZ="24dp"
        app:tint="#FFFFFF" />

    <!-- Bouton Fermer (X) en premier plan (Z-index supérieur) -->
    <ImageButton
        android:id="@+id/ibClosePreview"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_alignParentTop="true"
        android:layout_alignParentEnd="true"
        android:layout_marginTop="20dp"
        android:layout_marginEnd="20dp"
        android:background="@drawable/badge_background"
        android:backgroundTint="#80000000"
        android:contentDescription="Fermer"
        android:elevation="24dp"
        android:padding="12dp"
        android:src="@android:drawable/ic_menu_close_clear_cancel"
        android:translationZ="24dp"
        app:tint="#FFFFFF" />

    <!-- Container inférieur pour les statistiques et réactions (style Facebook) -->
    <RelativeLayout
        android:id="@+id/layoutPreviewBottom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:background="#99000000"
        android:padding="16dp"
        android:visibility="gone">

        <!-- Partie gauche : Auteur et stats (j'aime, commentaires, partages) -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_toStartOf="@+id/tvPreviewReaction"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvPreviewAuthorName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvPreviewStats"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="#DDDDDD"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- Partie droite : Emoji / Réaction -->
        <TextView
            android:id="@+id/tvPreviewReaction"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="@drawable/badge_background"
            android:backgroundTint="#2196F3"
            android:padding="8dp"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:visibility="gone" />

    </RelativeLayout>

</RelativeLayout>
