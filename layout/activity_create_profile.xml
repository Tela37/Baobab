<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/register"
    android:fillViewport="true"
    tools:layout_editor_absoluteX="1dp"
    tools:layout_editor_absoluteY="1dp">


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        tools:context=".CreateProfileActivity">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbarCreateProfile"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/green"
            app:title="Créer mon Profil"
            app:titleTextColor="#FFFFFF" />

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/imgCreateProfileAvatar"
            android:layout_width="150dp"
            android:layout_height="150dp"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_profile"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full" />

        <LinearLayout
            android:id="@+id/linearLayout_2cp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:inputType="textCapSentences"
            android:orientation="vertical">

            <EditText
                android:id="@+id/etLastName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_marginTop="5dp"
                android:layout_marginEnd="10dp"
                android:background="@drawable/bg_et"
                android:drawablePadding="7dp"
                android:hint="Nom"
                android:inputType="textCapSentences"
                android:maxLength="25"
                android:padding="10sp"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:textColor="@color/black"
                android:textColorHint="@color/grey"
                app:drawableStartCompat="@drawable/bao_custom_person_input" />
            <EditText
                android:id="@+id/etFirstName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_marginTop="5dp"
                android:layout_marginEnd="10dp"
                android:background="@drawable/bg_et"
                android:drawablePadding="7dp"
                android:hint="Prénom"
                android:inputType="textCapSentences"
                android:maxLength="25"
                android:padding="10sp"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:textColor="@color/black"
                android:textColorHint="@color/grey"
                app:drawableStartCompat="@drawable/bao_custom_person_input" />


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="10dp"
                android:padding="7dp"
                android:layout_marginVertical="5dp"
                android:background="@drawable/bg_et"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="10dp"
                        android:drawablePadding="1dp"
                        android:hint="Date de naissance et Sexe"
                        android:textColor="@color/black"
                        android:textColorHint="@color/grey"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        app:drawableStartCompat="@drawable/calendrier" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="30dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/etDob"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:layout_marginStart="10dp"
                        android:src="@drawable/person"
                        android:text="jour/mois/année"
                        android:textColor="@color/grey"
                        android:textSize="20dp" />



                    <Spinner
                        android:id="@+id/spinner"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:layout_marginStart="20sp"
                        android:layout_marginEnd="5sp" />

                </LinearLayout>
            </LinearLayout>

            <EditText
                android:id="@+id/profession"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"
                android:background="@drawable/bg_et"
                android:drawablePadding="7dp"
                android:hint="Profession"
                android:inputType="textCapSentences"
                android:maxLength="35"
                android:padding="10sp"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:textColorHint="@color/grey"
                app:drawableStartCompat="@drawable/bao_custom_prof_input" />

            <EditText
                android:id="@+id/biographie"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"
                android:layout_marginTop="5dp"
                android:background="@drawable/bg_et"
                android:drawablePadding="7dp"
                android:hint="Bio"
                android:inputType="textCapSentences"
                android:maxLength="35"
                android:padding="10sp"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:textColorHint="@color/grey"
                app:drawableStartCompat="@drawable/bao_custom_bio_input" />

            <EditText
                android:id="@+id/cp_matrimonial"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"
                android:layout_marginTop="5dp"
                android:background="@drawable/bg_et"
                android:drawablePadding="7dp"
                android:hint="Situation amoureuse"
                android:inputType="textCapSentences"
                android:maxLength="35"
                android:padding="10sp"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:textColorHint="@color/grey"
                app:drawableStartCompat="@drawable/bao_custom_amour_input" />


            <TextView
                android:id="@+id/tvEmailDisplay"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"
                android:layout_marginTop="5dp"
                android:background="@drawable/bg_et"
                android:drawablePadding="7dp"
                android:hint="Email"
                android:maxLength="35"
                android:padding="10sp"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:textColorHint="@color/grey"
                app:drawableStartCompat="@drawable/bao_custom_email_input"/>


            <EditText
                android:id="@+id/setup_telephone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_marginTop="5dp"
                android:layout_marginEnd="10dp"
                android:background="@drawable/bg_et"
                android:drawablePadding="7dp"
                android:hint="Téléphone"
                android:inputType="phone"
                android:maxLength="35"
                android:padding="10sp"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:textColorHint="@color/grey"
                app:drawableStartCompat="@drawable/bao_custom_phone_input" />

            <EditText
                android:id="@+id/etNeighborhood"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_marginTop="5dp"
                android:layout_marginEnd="10dp"
                android:background="@drawable/bg_et"
                android:drawablePadding="7dp"
                android:hint="Quartier"
                android:inputType="textCapSentences"
                android:maxLength="35"
                android:padding="10sp"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:textColorHint="@color/grey"
                app:drawableLeftCompat="@drawable/bao_custom_ville_input" />

            <EditText
                android:id="@+id/etCity"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_marginTop="5dp"
                android:layout_marginEnd="10dp"
                android:background="@drawable/bg_et"
                android:drawablePadding="7dp"
                android:hint="Ville"
                android:inputType="textCapSentences"
                android:maxLength="35"
                android:padding="10sp"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:textColorHint="@color/grey"
                app:drawableLeftCompat="@drawable/bao_custom_quartier_input" />

            <EditText
                android:id="@+id/etCountry"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_marginTop="5dp"
                android:layout_marginEnd="10dp"
                android:layout_marginBottom="5dp"
                android:background="@drawable/bg_et"
                android:drawablePadding="7dp"
                android:hint="Pays"
                android:inputType="textCapSentences"
                android:maxLength="35"
                android:padding="10sp"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:textColorHint="@color/grey"
                app:drawableLeftCompat="@drawable/bao_custom_pays_input" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <Button
                android:id="@+id/btnSubmitProfile"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="60sp"
                android:layout_marginVertical="10dp"
                android:layout_weight="1"
                android:background="@drawable/button"
                android:gravity="center"
                android:padding="10dp"
                android:text="Créer mon profil"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="20sp"
                android:textStyle="bold" />

            <ProgressBar
                android:id="@+id/progressBarCreateProfile"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginVertical="10dp"
                android:visibility="gone" />

        </LinearLayout>
    </LinearLayout>
</ScrollView>