<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="105dp"
    android:layout_height="160dp"
    android:layout_marginStart="4dp"
    android:layout_marginTop="6dp"
    android:layout_marginEnd="4dp"
    android:layout_marginBottom="6dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    app:cardCornerRadius="12dp"
    app:cardElevation="3dp">

    <RelativeLayout
        android:id="@+id/cardContainerCreate"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="true"
        android:focusable="true">

        <!-- Image de profil de l'utilisateur (Partie supérieure) -->
        <ImageView
            android:id="@+id/imgUserAvatar"
            android:layout_width="match_parent"
            android:layout_height="105dp"
            android:layout_alignParentTop="true"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_profile" />

        <!-- Zone inférieure blanche -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_alignParentBottom="true"
            android:background="#FFFFFF"
            android:gravity="center"
            android:paddingStart="4dp"
            android:paddingTop="12dp"
            android:paddingEnd="4dp"
            android:paddingBottom="4dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:maxLines="2"
                android:text="Créer une story"
                android:textColor="#000000"
                android:textSize="11sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Bouton (+) bleu chevauchant le milieu -->
        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/imgCreatePlus"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="89dp"
            android:background="#1877F2"
            android:padding="4dp"
            android:src="@android:drawable/ic_input_add"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full"
            app:strokeColor="#FFFFFF"
            app:strokeWidth="2dp"
            app:tint="#FFFFFF" />

    </RelativeLayout>

</com.google.android.material.card.MaterialCardView>