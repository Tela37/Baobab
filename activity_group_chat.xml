<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbarGroupChat"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="#2196F3"
        app:titleTextColor="#FFFFFF">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvGroupChatTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Nom du groupe"
                    android:textColor="#FFFFFF"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvGroupChatSubTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Membres..."
                    android:textColor="#E0E0E0"
                    android:textSize="11sp" />

            </LinearLayout>

            <ImageButton
                android:id="@+id/ibGroupSettings"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Paramètres du groupe"
                android:src="@android:drawable/ic_menu_manage"
                app:tint="#FFFFFF" />

        </LinearLayout>

    </androidx.appcompat.widget.Toolbar>

    <!-- Zone d'alerte si le groupe est verrouillé par l'administrateur -->
    <LinearLayout
        android:id="@+id/layoutGroupLockedBanner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFE0B2"
        android:gravity="center"
        android:orientation="horizontal"
        android:padding="8dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvGroupLockedInfo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🔒 Ce groupe est verrouillé par l'administrateur. Seuls les administrateurs peuvent envoyer des messages."
            android:textColor="#E65100"
            android:textSize="12sp"
            android:textStyle="bold" />

    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvGroupMessages"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:padding="8dp" />

    <!-- Zone d'envoi de message -->
    <LinearLayout
        android:id="@+id/layoutGroupSend"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        android:elevation="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="8dp">

        <ImageButton
            android:id="@+id/ibAttachGroupImage"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Joindre une photo"
            android:src="@android:drawable/ic_menu_camera" />

        <EditText
            android:id="@+id/etGroupMessage"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="Écrire un message de groupe..."
            android:inputType="textCapSentences|textMultiLine"
            android:maxLines="4"
            android:minHeight="48dp"
            android:padding="12dp" />

        <Button
            android:id="@+id/btnSendGroupMessage"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:text="Envoyer" />

    </LinearLayout>

</LinearLayout>
