<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- Photo de la Story en plein écran -->
    <ImageView
        android:id="@+id/imgStoryViewerPhoto"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="Photo de la story"
        android:scaleType="fitCenter" />

    <!-- En-tête : Barre de progression + Auteur -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:background="#80000000"
        android:orientation="vertical"
        android:padding="8dp">

        <ProgressBar
            android:id="@+id/progressStoryTimer"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:layout_marginBottom="8dp"
            android:max="100"
            android:progress="100"
            android:progressTint="#2196F3" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/imgStoryViewerAvatar"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_profile"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvStoryViewerAuthorName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvStoryViewerTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#D0D0D0"
                    android:textSize="11sp" />

            </LinearLayout>

            <ImageButton
                android:id="@+id/ibCloseStoryViewer"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Fermer"
                android:elevation="20dp"
                android:padding="8dp"
                android:src="@android:drawable/ic_menu_close_clear_cancel"
                android:translationZ="20dp"
                app:tint="#FFFFFF" />

        </LinearLayout>

    </LinearLayout>

    <!-- Pied de page : Légende + Barre de Réactions Émojis -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:background="#80000000"
        android:orientation="vertical"
        android:padding="12dp">

        <TextView
            android:id="@+id/tvStoryViewerCaption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:visibility="gone" />

        <!-- Bandeau de sélection d'émojis (FB/WhatsApp style) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:text="Réagir :"
                android:textColor="#E0E0E0"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/btnEmojiHeart"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="6dp"
                android:text="❤️"
                android:textSize="22sp" />

            <TextView
                android:id="@+id/btnEmojiLaugh"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="6dp"
                android:text="😂"
                android:textSize="22sp" />

            <TextView
                android:id="@+id/btnEmojiLike"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="6dp"
                android:text="👍"
                android:textSize="22sp" />

            <TextView
                android:id="@+id/btnEmojiWow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="6dp"
                android:text="😮"
                android:textSize="22sp" />

            <TextView
                android:id="@+id/btnEmojiSad"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="6dp"
                android:text="😢"
                android:textSize="22sp" />

            <TextView
                android:id="@+id/btnEmojiAngry"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="6dp"
                android:text="😡"
                android:textSize="22sp" />

        </LinearLayout>

        <TextView
            android:id="@+id/tvCurrentReaction"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="4dp"
            android:textColor="#2196F3"
            android:textSize="12sp"
            android:visibility="gone" />

    </LinearLayout>

</RelativeLayout>